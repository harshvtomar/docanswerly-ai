{
  "name": "docanswerly-ai",
  "version": "0.2.0",
  "description": "DocAnswerly AI \u2014 Upload Documents. Ask Questions. Get Answers. Multilingual English/Hindi document intelligence.",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.checks.json && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prebuild": "npm run prepare:assets && npm run prepare:model && npm run prepare:generation",
    "predev": "npm run prepare:assets && npm run prepare:model && npm run prepare:generation",
    "test:pdf": "npm run prepare:assets && node scripts/evaluate.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts/*.mjs *.ts *.json docs/*.md *.md",
    "prepare:model": "node scripts/prepare-model.mjs",
    "test:retrieval": "npm run prepare:model && node --import tsx scripts/evaluate-retrieval.ts",
    "prepare:generation": "node scripts/prepare-generation.mjs",
    "test:hybrid": "npm run prepare:model && node --import tsx scripts/evaluate-hybrid.ts",
    "build:evaluation": "vite build --config vite.evaluation.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshvtomar/docanswerly-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/harshvtomar/docanswerly-ai/issues"
  },
  "homepage": "https://github.com/harshvtomar/docanswerly-ai#readme",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@wllama/wllama": "3.8.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true
}
